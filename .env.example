# The Search — see docs/the-search/vision.md
# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=
# Supabase service-role key — server-only, never exposed to the client (Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=
# Shared password gating /the-search
THE_SEARCH_PASSWORD=
# Random secret used to sign the session cookie once logged in (any long random string)
THE_SEARCH_SESSION_SECRET=
